NODE_ENV=production
PORT=3000
DB_PROVIDER=neon
# Copie a URL POOLED do painel Neon; somente Render/API, NUNCA EXPO_PUBLIC_*.
DATABASE_URL=postgresql://USER:PASSWORD@ep-EXEMPLO-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_POOL_MAX=3
# Limite de revisoes retidas por tema para controlar os 1 GB do Neon Free (minimo 2).
ZUP_CONTENT_REVISION_LIMIT=3
CORS_ORIGINS=https://seu-dominio.com

# URL HTTPS publica do proprio backend no Render. Usada nos webhooks/retornos.
PUBLIC_API_URL=https://seu-zup-api.onrender.com

# Segredos: SOMENTE no backend/Render. Nunca coloque em EXPO_PUBLIC_*.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# Publicacao do acervo remoto: gere 32 bytes aleatorios, configure SOMENTE no
# Render e no terminal local do editor. NUNCA em EXPO_PUBLIC_* ou no Git.
ZUP_CONTENT_ADMIN_TOKEN=
